# Stage 1: Dependencies
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
RUN corepack enable
WORKDIR /app

COPY package.json ./
COPY prisma ./prisma
# Skip postinstall (prisma generate) — we run it explicitly in builder
RUN pnpm install --ignore-scripts

# Stage 2: Builder
FROM node:20-alpine AS builder
RUN corepack enable
# Fix pnpm global bin directory
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Now generate Prisma client explicitly (node_modules is fully present)
RUN pnpm exec prisma generate

# Build Next.js app
RUN pnpm run build

# Bundle seed script (bcryptjs kept external — we'll copy it to runner)
RUN pnpm add -g esbuild
RUN esbuild prisma/seed-prod.ts \
    --bundle --platform=node --target=node20 \
    --external:@prisma/client --external:bcryptjs \
    --outfile=prisma/seed-prod.cjs

# Bundle prisma.config.ts so runner needs NO node_modules
# This inlines `prisma/config` so the runner's global prisma CLI can load it
RUN esbuild prisma.config.ts \
    --bundle --platform=node --target=node20 --format=cjs \
    --outfile=prisma.config.bundled.js

# Stage 3: Runner
FROM node:20-alpine AS runner
RUN corepack enable
# Fix pnpm global bin directory
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

ENV NODE_ENV=production
RUN pnpm add -g prisma@7.5.0

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma/seed-prod.cjs ./prisma/seed-prod.cjs

# Copy bundled config (self-contained, no node_modules required)
COPY --from=builder /app/prisma.config.bundled.js ./prisma.config.js

# Copy bcryptjs so seed-prod.cjs works at runtime
COPY --from=builder /app/node_modules/bcryptjs ./node_modules/bcryptjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["sh", "-c", "prisma migrate deploy && node prisma/seed-prod.cjs && node server.js"]
