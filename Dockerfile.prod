# Stage 1: Dependencies
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package.json package-lock.json* ./
COPY prisma ./prisma
# Skip postinstall (prisma generate) — we run it explicitly in builder
RUN npm install --ignore-scripts

# Stage 2: Builder
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Now generate Prisma client explicitly (node_modules is fully present)
RUN npx prisma generate

# Build Next.js app
RUN npm run build

# Bundle seed script (self-contained, handles its own dependencies)
RUN npm install -g esbuild
RUN esbuild prisma/seed.ts \
    --bundle --platform=node --target=node20 \
    --external:@prisma/client \
    --outfile=prisma/seed.cjs

# Bundle prisma.config.ts so runner needs NO node_modules
# This inlines `prisma/config` so the runner's global prisma CLI can load it
RUN esbuild prisma.config.ts \
    --bundle --platform=node --target=node20 --format=cjs \
    --outfile=prisma.config.bundled.js

# Stage 3: Runner
FROM node:20-alpine AS runner
RUN apk add --no-cache libc6-compat
WORKDIR /app

ENV NODE_ENV=production
RUN npm install -g prisma@7.5.0

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma/seed.cjs ./prisma/seed.cjs
COPY --from=builder /app/package.json ./package.json

# Copy bundled config (self-contained, no node_modules required)
COPY --from=builder /app/prisma.config.bundled.js ./prisma.config.js

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["sh", "-c", "prisma migrate deploy && node prisma/seed.cjs && node server.js"]
