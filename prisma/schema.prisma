generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Admin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id     Int     @id @default(autoincrement())
  userId Int     @unique
  bio    String?
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   Int               @id @default(autoincrement())
  name                 String?
  firstName            String?
  lastName             String?
  username             String?           @unique
  phoneNumber          String?
  email                String            @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  roles                Role[]            @default([USER])
  pricingPlanId        Int?
  passwordResetToken   String?           @unique
  passwordResetExpires DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  subscriptionId       String?
  subscriptionStatus   String?
  accounts             Account[]
  admin                Admin?
  leads                CallbackRequest[] @relation("AgentLeads")
  createdDevelopers    Developer[]
  Media                Media[]
  ledgerTransactions   LedgerTransaction[]
  entitlementGrants    EntitlementGrant[]
  posts                Post[]
  profile              Profile?
  approvedProjects     Project[]         @relation("ProjectApprovals")
  projects             Project[]
  approvedProperties   Property[]        @relation("PropertyApprovals")
  properties           Property[]
  sessions             Session[]
  subscriptions        Subscription[]
  promotions           Promotion[]
  pricingPlan          PricingPlan?      @relation(fields: [pricingPlanId], references: [id])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               Int
  planId               Int
  couponId             String?
  paypalSubscriptionId String             @unique
  status               SubscriptionStatus @default(PENDING)
  startDate            DateTime           @default(now())
  endDate              DateTime?
  nextBillingDate      DateTime?
  priceAtSubscription  Decimal            @db.Decimal(10, 2)
  currency             String             @default("USD")
  featuredCreditsUsed  Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  plan                 PricingPlan        @relation(fields: [planId], references: [id])
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon               Coupon?            @relation(fields: [couponId], references: [id])

  @@index([userId])
  @@index([status])
}

model Coupon {
  id                String         @id @default(cuid())
  name              String
  code              String         @unique
  type              CouponType
  targetType        CouponTarget   @default(ALL)
  value             Decimal        @db.Decimal(10, 2)
  maxUsage          Int?
  perUserLimit      Int?
  usedCount         Int            @default(0)
  validFrom         DateTime?
  validTo           DateTime?
  isActive          Boolean        @default(true)
  appliesToAllPlans Boolean        @default(true)
  planIds           Int[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  subscriptions     Subscription[]
}



model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]

  @@index([slug])
}

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  tags        String[]  @default([])
  published   Boolean   @default(false)
  authorId    Int
  categoryId  Int?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([authorId])
  @@index([categoryId])
  @@index([published])
  @@index([createdAt])
}

model CallbackRequest {
  id              Int           @id @default(autoincrement())
  fullName        String
  phone           String
  email           String
  preferredTime   String?
  contactMethod   ContactMethod
  purchasePurpose String?
  budget          Int?
  location        String?
  message         String?
  propertyId      Int?
  projectId       Int?
  agentId         Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  agent           User?         @relation("AgentLeads", fields: [agentId], references: [id])
  project         Project?      @relation(fields: [projectId], references: [id])
  property        Property?     @relation(fields: [propertyId], references: [id])
}

model PricingPlan {
  id                  Int            @id @default(autoincrement())
  name                String         @unique
  slug                String         @unique
  description         String?
  type                PlanType       @default(SUBSCRIPTION)
  rank                Int            @default(0)
  priceMonthly        Decimal?       @db.Decimal(10, 2)
  priceYearly         Decimal?       @db.Decimal(10, 2)
  priceOneTime        Decimal?       @db.Decimal(10, 2)
  isActive            Boolean        @default(true)
  paypalPlanId        String?
  paypalProductId     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  subscriptions       Subscription[]
  users               User[]
  entitlements        PlanEntitlement[]
}

model PlanEntitlement {
  id           Int                   @id @default(autoincrement())
  planId       Int
  definitionId String                // References EntitlementDefinition.id
  amount       Int                   // How many of this entitlement the plan gives

  plan         PricingPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  definition   EntitlementDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([planId, definitionId])
}

model Property {
  id                    Int                  @id @default(autoincrement())
  title                 String
  slug                  String               @unique
  description           String?
  price                 Decimal              @db.Decimal(12, 2)
  currency              String               @default("AED")
  isFeatured            Boolean              @default(false)
  propertyTypeId        Int
  listingType           ListingType          @default(SALE)
  developerId           Int?
  proposedDeveloperName String?
  bedrooms              Int?
  bathrooms             Int?
  builtUpArea           Float?
  areaUnit              String?              @default("sqft")
  refNo                 String?              @unique
  location              String
  address               String?
  latitude              Float?
  longitude             Float?
  furnishing            FurnishingStatus     @default(UNFURNISHED)
  availability          PropertyAvailability @default(AVAILABLE)
  status                PropertyStatus       @default(DRAFT)
  editorialStatus       EditorialStatus      @default(DRAFT)
  moderationStatus      ModerationStatus     @default(PENDING_REVIEW)
  systemStatus          SystemStatus         @default(ACTIVE)
  views                 Int                  @default(0)
  createdById           Int
  /// @deprecated Use editorialStatus, moderationStatus, and systemStatus instead
  published             Boolean              @default(false)
  approvedById          Int?
  publishedAt           DateTime?
  declinedReason        String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  leads                 CallbackRequest[]
  mediaUsages           MediaUsage[]
  approvedBy            User?                @relation("PropertyApprovals", fields: [approvedById], references: [id])
  createdBy             User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  developer             Developer?           @relation(fields: [developerId], references: [id])
  propertyType          PropertyType         @relation(fields: [propertyTypeId], references: [id])
  features              PropertyFeature[]
  images                PropertyImage[]
  videos                PropertyVideo[]
  promotions            Promotion[]

  @@index([slug])
  @@index([price])
  @@index([propertyTypeId])
  @@index([status])
  @@index([editorialStatus])
  @@index([moderationStatus])
  @@index([systemStatus])
  @@index([availability])
  @@index([createdById])
}

model PropertyType {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  properties  Property[]
}

model PropertyImage {
  id         Int      @id @default(autoincrement())
  url        String
  alt        String?
  isPrimary  Boolean  @default(false)
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyVideo {
  id         Int      @id @default(autoincrement())
  url        String
  provider   String?
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Media {
  id           Int          @id @default(autoincrement())
  url          String
  publicId     String?
  type         MediaType    @default(IMAGE)
  alt          String?
  title        String?
  mimeType     String?
  size         Int?
  uploadedById Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])
  usages       MediaUsage[]

  @@index([type])
  @@index([uploadedById])
}

model MediaUsage {
  id         Int       @id @default(autoincrement())
  mediaId    Int
  entityId   Int
  entityType String
  role       String?
  createdAt  DateTime  @default(now())
  propertyId Int?
  media      Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  Property   Property? @relation(fields: [propertyId], references: [id])

  @@index([entityType, entityId])
}

model Feature {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  slug        String            @unique
  icon        String?
  category    String?
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  properties  PropertyFeature[]
}

model PropertyFeature {
  propertyId Int
  featureId  Int
  feature    Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, featureId])
}

model Developer {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  slug        String          @unique
  logo        String?
  description String?
  website     String?
  email       String?
  phone       String?
  status      DeveloperStatus @default(PENDING)
  createdById Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   User?           @relation(fields: [createdById], references: [id])
  projects    Project[]
  properties  Property[]

  @@index([slug])
  @@index([status])
}

model Project {
  id                    Int                @id @default(autoincrement())
  name                  String
  slug                  String             @unique
  description           String?
  tagline               String?
  aboutContent          String?
  projectType           ProjectType        @default(CURRENT)
  status                ProjectStatus      @default(DRAFT)
  editorialStatus       EditorialStatus    @default(DRAFT)
  moderationStatus      ModerationStatus   @default(PENDING_REVIEW)
  systemStatus          SystemStatus       @default(ACTIVE)
  isFeatured            Boolean            @default(false)
  views                 Int                @default(0)
  community             String?
  location              String
  address               String?
  latitude              Float?
  longitude             Float?
  locationDescription   String?
  priceFrom             Decimal?           @db.Decimal(12, 2)
  currency              String             @default("AED")
  paymentPlanSummary    String?
  handoverDate          DateTime?
  announcementDate      DateTime?
  bookingOpenedDate     DateTime?
  constructionStartDate DateTime?
  progressPercentage    Int?
  progressStatus        String?
  progressImage         String?
  developerId           Int?
  proposedDeveloperName String?
  createdById           Int
  approvedById          Int?
  /// @deprecated Use editorialStatus, moderationStatus, and systemStatus instead
  published             Boolean            @default(false)
  publishedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  leads                 CallbackRequest[]
  nearbyAttractions     NearbyAttraction[]
  paymentPlan           PaymentPlanStage[]
  approvedBy            User?              @relation("ProjectApprovals", fields: [approvedById], references: [id])
  createdBy             User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  developer             Developer?         @relation(fields: [developerId], references: [id])
  faqs                  ProjectFAQ[]
  features              ProjectFeature[]
  floorplans            ProjectFloorplan[]
  progressTimeline      ProjectProgress[]
  amenities             ProjectAmenity[]   @relation("ProjectToProjectAmenity")
  promotions            Promotion[]

  @@index([slug])
  @@index([projectType])
  @@index([status])
  @@index([editorialStatus])
  @@index([moderationStatus])
  @@index([systemStatus])
  @@index([developerId])
  @@index([createdById])
}

model ProjectFloorplan {
  id        Int      @id @default(autoincrement())
  projectId Int
  unitType  UnitType
  unitName  String?
  bedrooms  Int?
  bathrooms Int?
  size      Float?
  sizeUnit  String?  @default("sqft")
  imageUrl  String?
  pdfUrl    String?
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectAmenity {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  icon      String?
  category  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[] @relation("ProjectToProjectAmenity")
}

model PaymentPlanStage {
  id           Int      @id @default(autoincrement())
  projectId    Int
  percentage   Int
  description  String
  triggerEvent String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model NearbyAttraction {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  distance  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectFAQ {
  id        Int      @id @default(autoincrement())
  projectId Int
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectFeature {
  id          Int      @id @default(autoincrement())
  projectId   Int
  name        String
  description String?
  icon        String?
  imageUrl    String?
  order       Int      @default(0)
  category    String   @default("AMENITY")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([category])
}

model ProjectProgress {
  id        Int      @id @default(autoincrement())
  projectId Int
  milestone String
  date      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([order])
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  WRITER
  MANAGER
  SUPPORT
  USER
}

enum EditorialStatus {
  DRAFT
  SUBMITTED
  ARCHIVED
}

enum ModerationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum SystemStatus {
  ACTIVE
  INACTIVE_BILLING
  INACTIVE_QUOTA
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
  PENDING
}



enum ContactMethod {
  Phone
  Email
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  DECLINED
  ARCHIVED
}

enum PropertyAvailability {
  AVAILABLE
  SOLD
  RENTED
  OFFPLAN
}

enum FurnishingStatus {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum ListingType {
  SALE
  RENT
  OFF_PLAN
}

enum ProjectType {
  FUTURE
  CURRENT
  PAST
}

enum ProjectStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  DECLINED
  ARCHIVED
}

enum UnitType {
  STUDIO
  ONE_BEDROOM
  ONE_BEDROOM_STUDY
  TWO_BEDROOM
  TWO_BEDROOM_STUDY
  THREE_BEDROOM
  THREE_BEDROOM_MAID
  FOUR_BEDROOM
  PENTHOUSE
  VILLA
  TOWNHOUSE
}

enum PlanType {
  SUBSCRIPTION
  ONE_TIME
  ADDON
}

enum DeveloperStatus {
  PENDING
  APPROVED
  DECLINED
}

enum CouponType {
  PERCENTAGE
  FIXED
  TRIAL
}

enum CouponTarget {
  SUBSCRIPTION
  ADDON
  ALL
}

enum PromotionType {
  SPOTLIGHT
  FEATURED
  BUMP_UP
}

enum PromotionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Promotion {
  id         String          @id @default(cuid())
  propertyId Int?
  projectId  Int?
  userId     Int
  type       PromotionType
  startDate  DateTime        @default(now())
  expiresAt  DateTime?
  paymentId  String?
  status     PromotionStatus @default(ACTIVE)
  createdAt  DateTime        @default(now())

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model LedgerTransaction {
  id           String            @id @default(uuid())
  userId       Int
  type         TransactionType
  status       TransactionStatus
  amount       Decimal           @db.Decimal(10, 2)
  currency     String            @default("USD")
  provider     String
  providerTxId String            @unique
  metadata     Json?
  occurredAt   DateTime
  createdAt    DateTime          @default(now())

  user         User              @relation(fields: [userId], references: [id])
}

enum TransactionType {
  PAYMENT
  REFUND
  DISPUTE
  CREDIT
  INFO
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum GrantStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model EntitlementDefinition {
  id               String               @id @default(cuid())
  name              String
  code             String               @unique // e.g., "PROPERTY_SLOT"
  description      String?
  grants           EntitlementGrant[]
  planEntitlements PlanEntitlement[]
}

model EntitlementGrant {
  id           String                @id @default(cuid())
  name              String
  userId       Int
  definitionId String
  amount       Int // Capacity (e.g., 5 slots)
  used         Int                   @default(0)
  sourceType   String // "SUBSCRIPTION", "BONUS"
  sourceId     String // Subscription.id
  validFrom    DateTime              @default(now())
  validTo      DateTime?
  status       GrantStatus           @default(ACTIVE)
  user         User                  @relation(fields: [userId], references: [id])
  definition   EntitlementDefinition @relation(fields: [definitionId], references: [id])

  @@index([userId, status])
}