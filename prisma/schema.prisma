generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  WRITER
  MANAGER
  SUPPORT
  USER
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
  PENDING
}

enum PaymentStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
}

enum ContactMethod {
  Phone
  Email
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  DECLINED
  ARCHIVED
}

enum PropertyAvailability {
  AVAILABLE
  SOLD
  RENTED
  OFFPLAN
}

enum FurnishingStatus {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum ListingType {
  SALE
  RENT
  OFF_PLAN
}

enum ProjectType {
  FUTURE
  CURRENT
  PAST
}

enum ProjectStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  DECLINED
  ARCHIVED
}

enum UnitType {
  STUDIO
  ONE_BEDROOM
  ONE_BEDROOM_STUDY
  TWO_BEDROOM
  TWO_BEDROOM_STUDY
  THREE_BEDROOM
  THREE_BEDROOM_MAID
  FOUR_BEDROOM
  PENTHOUSE
  VILLA
  TOWNHOUSE
}

enum PlanType {
  SUBSCRIPTION
  ONE_TIME
}

enum DeveloperStatus {
  PENDING
  APPROVED
  DECLINED
}
