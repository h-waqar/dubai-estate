# --- Base Config ---
NODE_ENV=
COMPOSE_PROJECT_NAME=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_BASE=
API_INTERNAL_BASE=

# --- Secrets (Shared) ---
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# --- Admin / Seeding ---
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=1122

# --- Database (Neon / Fallback) ---
# NOTE: These are for Vercel Production.
# Locally, these are overridden by .env.local (if running npm run dev)
# Docker containers use the hardcoded values in docker-compose.yml
DATABASE_URL=
DIRECT_URL=

# --- Integrations ---
